class NativeError(Exception): ...

class DocumentHandle:
    def read_drawing(
        self,
        entry_id: str | None = ...,
        mode: str = ...,
        user_data_profile: str = ...,
        image_profile: str = ...,
        import_root: str | None = ...,
    ) -> DrawingHandle: ...
    def read_scene(
        self,
        entry_id: str | None = ...,
        mode: str = ...,
        user_data_profile: str = ...,
        image_profile: str = ...,
        import_root: str | None = ...,
    ) -> SceneHandle: ...
    def parse_hsf(
        self,
        entry_id: str | None = ...,
        mode: str = ...,
        user_data_profile: str = ...,
        image_profile: str = ...,
    ) -> HsfHandle: ...
    def inspection_json(self) -> str: ...
    def metadata_json(self) -> str: ...
    def extract(self, entry_id: str) -> tuple[bytes, str]: ...
    def verify_all_json(self) -> str: ...
    def inspect_hsf_json(self, entry_id: str | None = ...) -> str: ...

class HsfHandle:
    def summary_json(self) -> str: ...
    def source_bytes(self, domain_id: str, offset: int, length: int) -> bytes: ...

def build_info() -> str: ...
def probe_bytes(data: bytes, limits: str) -> str: ...
def probe_path(path: str, limits: str) -> str: ...
def inspect_bytes(data: bytes, options: str) -> str: ...
def inspect_path(path: str, options: str) -> str: ...
def read_bytes(data: bytes, options: str) -> DocumentHandle: ...
def read_path(path: str, options: str) -> DocumentHandle: ...

class SceneHandle:
    def mesh_index(self, mesh_id: str) -> int: ...
    def shell_parameters(self, set_id: str) -> bytes: ...
    def summary_json(self) -> str: ...
    def source_bytes(self, domain_id: str, offset: int, length: int) -> bytes: ...
    def buffer(self, mesh_id: str, kind: str) -> bytes: ...
    def primitive_points(self, primitive_id: str) -> bytes: ...

class DrawingHandle:
    def summary_json(self) -> str: ...
    def source_bytes(self, domain_id: str, offset: int, length: int) -> bytes: ...
    def primitive_points(self, primitive_id: str) -> bytes: ...
